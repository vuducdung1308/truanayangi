{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "truanayangi-counter",
  "main": "worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truanayangi-counter",
      "migrations_dir": "migrations",
      // Replace with the id printed by: npx wrangler d1 create truanayangi-counter
      "database_id": ""
    }
  ],
  "ratelimits": [
    {
      "name": "SPIN_RATE_LIMITER",
      "namespace_id": "1909202601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://vuducdung1308.github.io"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
}
